<?php
$pidFile = '/var/run/dormouse.pid';
$running = false;
if (file_exists($pidFile)) {
    $pid = (int) trim((string) file_get_contents($pidFile));
    $running = $pid > 0 && posix_kill($pid, 0);
}
?>
<h1>Dormouse</h1>
<p>Phase 2 — observation mode. No moves happen; this page is read-only.</p>
<p>Service status: <b><?= $running ? 'running' : 'stopped' ?></b></p>

<div id="dormouse-status">Loading activity…</div>

<script>
// rel_path and client_ip come from filenames/IPs observed on the network —
// never trust them into innerHTML unescaped (a filename could contain
// "<img onerror=...>"). Every interpolated field below must go through esc().
function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

function humanBytes(n) {
    if (n === null || n === undefined) { return '—'; }
    var units = ['B', 'KB', 'MB', 'GB', 'TB'];
    var i = 0;
    n = Number(n);
    while (Math.abs(n) >= 1024 && i < units.length - 1) {
        n /= 1024;
        i++;
    }
    return n.toFixed(i === 0 ? 0 : 1) + ' ' + units[i];
}

function orDash(n) {
    return n === null || n === undefined ? '—' : n;
}

function renderZfsWindow(rows) {
    if (!rows || !rows.length) { return '(no ZFS I/O in this window)'; }
    return rows.map(function (r) {
        return esc(r.name) + ' (' + esc(r.kind) + '): ' + esc(orDash(r.reads)) + ' reads, ' + esc(humanBytes(r.nread));
    }).join('<br>');
}

function dormouseRender(data) {
    var el = document.getElementById('dormouse-status');
    if (data.error) {
        el.innerHTML = '<p>' + esc(data.error) + '</p>';
        return;
    }
    var html = '';
    html += '<p>Daemon: <b>' + (data.daemon_running ? 'running' : 'stopped') + '</b></p>';
    html += '<p>Watched shares: ' + esc(data.watched_shares.join(', ')) + '</p>';
    html += '<p>Watch dirs: ' + esc(data.watch_count) + ' (last refresh: ' +
        (data.watch_last_refresh_ts ? esc(new Date(data.watch_last_refresh_ts * 1000).toLocaleString()) : 'never') + ')</p>';
    html += '<p>Inotify overflow count: ' + esc(data.overflow_count) + '</p>';
    html += '<p>Disk last poll: ' +
        (data.disk_last_poll_ts ? esc(new Date(data.disk_last_poll_ts * 1000).toLocaleString()) : 'never') +
        ' — smartctl disagreements: ' + esc(data.disk_state_disagreements) + '</p>';

    html += '<h3>Disk state</h3><table border="1" cellpadding="4"><tr><th>Disk</th><th>State</th><th>Since</th></tr>';
    for (var disk in data.disk_states) {
        var d = data.disk_states[disk];
        html += '<tr><td>' + esc(disk) + '</td><td>' + (d.spundown ? 'spun down' : 'active') + '</td><td>' +
            (d.since ? esc(new Date(d.since * 1000).toLocaleString()) : 'unknown') + '</td></tr>';
    }
    html += '</table>';

    html += '<h3>Disk spin events</h3><table border="1" cellpadding="4"><tr><th>Time</th><th>Disk</th><th>Event</th><th>Reads &Delta;</th><th>Writes &Delta;</th><th>Around the transition</th><th>ZFS I/O (&plusmn;60s)</th></tr>';
    data.spin_events.forEach(function (ev) {
        var around = ev.before.concat(ev.after).map(function (row) {
            return esc(row.source + '/' + row.event + ' ' + row.rel_path + (row.client_ip ? ' (' + row.client_ip + ')' : ''));
        }).join('<br>');
        html += '<tr><td>' + esc(new Date(ev.ts * 1000).toLocaleString()) + '</td><td>' + esc(ev.disk) + '</td><td>' +
            esc(ev.event) + '</td><td>' + esc(ev.reads_delta === null ? '—' : ev.reads_delta) + '</td><td>' +
            esc(ev.writes_delta === null ? '—' : ev.writes_delta) + '</td><td>' + around + '</td><td>' +
            renderZfsWindow(ev.zfs_window) + '</td></tr>';
    });
    html += '</table>';

    html += '<h3>ZFS I/O — last 24h by dataset</h3>';
    html += '<p>Datasets tracked: ' + esc(data.zfs_dataset_count) + ' — last poll: ' +
        (data.zfs_last_poll_ts ? esc(new Date(data.zfs_last_poll_ts * 1000).toLocaleString()) : 'never') + '</p>';
    html += '<table border="1" cellpadding="4"><tr><th>Dataset</th><th>Reads</th><th>Read</th><th>Writes</th><th>Written</th><th>Unlinks</th></tr>';
    for (var dataset in data.zfs_24h) {
        var z = data.zfs_24h[dataset];
        html += '<tr><td>' + esc(dataset) + '</td><td>' + esc(orDash(z.reads)) + '</td><td>' + esc(humanBytes(z.nread)) +
            '</td><td>' + esc(orDash(z.writes)) + '</td><td>' + esc(humanBytes(z.nwritten)) + '</td><td>' + esc(orDash(z.unlinks)) + '</td></tr>';
    }
    html += '</table>';

    html += '<h3>Last 24h by share</h3><table border="1" cellpadding="4"><tr><th>Share</th><th>SMB opens</th><th>Inotify accesses</th></tr>';
    for (var share in data.per_share_24h) {
        var row = data.per_share_24h[share];
        html += '<tr><td>' + esc(share) + '</td><td>' + esc(row.smb_open) + '</td><td>' + esc(row.inotify_access) + '</td></tr>';
    }
    html += '</table>';

    html += '<h3>Last 50 activity rows</h3><table border="1" cellpadding="4"><tr><th>Time</th><th>Share</th><th>Path</th><th>Client IP</th><th>Source</th><th>Event</th><th>Count</th></tr>';
    data.recent.forEach(function (row) {
        html += '<tr><td>' + esc(new Date(row.ts * 1000).toLocaleString()) + '</td><td>' + esc(row.share) + '</td><td>' +
            esc(row.rel_path) + '</td><td>' + esc(row.client_ip) + '</td><td>' + esc(row.source) + '</td><td>' + esc(row.event) +
            '</td><td>' + esc(row.count) + '</td></tr>';
    });
    html += '</table>';

    el.innerHTML = html;
}

function dormousePoll() {
    $.post('/plugins/dormouse/scripts/dormouse-api.php', { csrf_token: csrf_token }, dormouseRender, 'json');
}

dormousePoll();
setInterval(dormousePoll, 15000);
</script>
