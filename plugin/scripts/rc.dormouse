#!/bin/bash
# Dormouse service control. Supervises dormoused and its inotifywait child.
set -u

PIDFILE="${DORMOUSE_PIDFILE:-/var/run/dormouse.pid}"
LOGFILE="${DORMOUSE_LOG:-/var/log/dormouse.log}"
DAEMON="$(dirname "$0")/dormoused"
RUNDIR="${DORMOUSE_RUNDIR:-/var/run/dormouse}"
# 20 iterations x 0.5s = 10s in production; tests override this to stay fast.
STOP_WAIT_ITERATIONS="${DORMOUSE_STOP_WAIT_ITERATIONS:-20}"

is_running() {
    [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "dormouse already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    rm -f "$PIDFILE"
    DORMOUSE_PIDFILE="$PIDFILE" DORMOUSE_LOG="$LOGFILE" "$DAEMON" </dev/null >>"$LOGFILE" 2>&1 &
    disown
    echo "dormouse started"
}

# Bracket the 'i' so pkill/pgrep's own -f pattern argument (which literally
# contains this string in the invoking process's argv) can never self-match,
# and match the full --fromfile path so this only ever touches Dormouse's
# own child — never the /boot/changes.txt watcher or the
# unraid-ops-fswatch container's inotifywait, which watch different paths.
INOTIFY_PATTERN="[i]notifywait.*--fromfile ${RUNDIR}/watch.list"

kill_inotify_child() {
    pkill -KILL -f "$INOTIFY_PATTERN" 2>/dev/null || true
}

stop() {
    if ! is_running; then
        rm -f "$PIDFILE"
        kill_inotify_child
        echo "dormouse not running"
        return 0
    fi
    local pid
    pid="$(cat "$PIDFILE")"
    kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 "$STOP_WAIT_ITERATIONS"); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "dormouse did not stop gracefully within the wait — escalating to SIGKILL"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi

    # A SIGKILL bypasses dormoused's own SIGTERM handler (which normally
    # stops its inotifywait child as part of a graceful shutdown), so make
    # sure the child is gone regardless of how dormoused went down — it
    # would otherwise be left watching the pool, orphaned, after every
    # forced stop.
    kill_inotify_child

    # Only clear the pidfile once the process is actually confirmed gone —
    # is_running() (and `restart`, which runs stop then start unconditionally)
    # key purely off pidfile presence, so removing it before confirming a
    # failed SIGKILL would let a fresh start spawn a second dormoused right
    # alongside the still-alive orphan.
    if kill -0 "$pid" 2>/dev/null; then
        echo "dormouse stop FAILED — pid $pid still alive after SIGKILL"
        return 1
    fi
    if pgrep -f "$INOTIFY_PATTERN" >/dev/null 2>&1; then
        echo "dormouse stop FAILED — an inotifywait child is still running"
        return 1
    fi
    rm -f "$PIDFILE"
    echo "dormouse stopped"
}

status() {
    if is_running; then
        echo "dormouse running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "dormouse stopped"
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
