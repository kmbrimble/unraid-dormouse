#!/bin/bash
# Dormouse service control. Phase 1: supervises a no-op daemon only.
set -u

PIDFILE="${DORMOUSE_PIDFILE:-/var/run/dormouse.pid}"
LOGFILE="${DORMOUSE_LOG:-/var/log/dormouse.log}"
DAEMON="$(dirname "$0")/dormoused"

is_running() {
    [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "dormouse already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    rm -f "$PIDFILE"
    DORMOUSE_PIDFILE="$PIDFILE" DORMOUSE_LOG="$LOGFILE" "$DAEMON" >>"$LOGFILE" 2>&1 &
    disown
    echo "dormouse started"
}

stop() {
    if ! is_running; then
        rm -f "$PIDFILE"
        echo "dormouse not running"
        return 0
    fi
    local pid
    pid="$(cat "$PIDFILE")"
    kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    rm -f "$PIDFILE"
    echo "dormouse stopped"
}

status() {
    if is_running; then
        echo "dormouse running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "dormouse stopped"
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
