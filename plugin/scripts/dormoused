#!/usr/bin/php
<?php
/**
 * Dormouse daemon — Phase 2, observation mode. Polls smbstatus -j and runs a
 * long-running inotifywait child over the pool-side watch dirs, unifying
 * both into the `activity` table. Moves nothing: this file must never call
 * any filesystem move, rename or delete primitive on anything under
 * pool_root or cache_root — enforced by tests/run.php's grep test over the
 * whole tree.
 *
 * Paths are overridable via DORMOUSE_PIDFILE / DORMOUSE_LOG / DORMOUSE_CFG /
 * DORMOUSE_RUNDIR so tests can exercise this without touching real paths.
 */
declare(strict_types=1);

require __DIR__ . '/lib.php';

$pidFile = getenv('DORMOUSE_PIDFILE') ?: '/var/run/dormouse.pid';
$logFile = getenv('DORMOUSE_LOG') ?: '/var/log/dormouse.log';
$cfgFile = getenv('DORMOUSE_CFG') ?: '/boot/config/plugins/dormouse/dormouse.cfg';
$runDir = getenv('DORMOUSE_RUNDIR') ?: '/var/run/dormouse';
$disksIniFile = getenv('DORMOUSE_DISKS_INI') ?: '/var/local/emhttp/disks.ini';

function dormouse_log(string $logFile, string $message): void
{
    $line = sprintf('[%s] %s%s', date('Y-m-d H:i:s'), $message, PHP_EOL);
    file_put_contents($logFile, $line, FILE_APPEND);
}

function dormouse_start_inotify_child(array $watchDirs, string $runDir, string $logFile): ?array
{
    if (!is_dir($runDir)) {
        mkdir($runDir, 0755, true);
    }
    $listFile = $runDir . '/watch.list';
    file_put_contents($listFile, implode("\n", $watchDirs) . "\n");

    $binary = trim((string) shell_exec('command -v inotifywait 2>/dev/null'));
    if ($binary === '') {
        dormouse_log($logFile, 'inotifywait binary not found — Source B disabled');
        return null;
    }
    if (count($watchDirs) === 0) {
        dormouse_log($logFile, 'no watch dirs to monitor — Source B idle');
        return null;
    }

    $cmd = [$binary, '-m', '-e', 'open,access,close_nowrite,close_write', '--format', '%w|%f|%e', '--fromfile', $listFile];
    // stderr goes straight to the log file, never a pipe we'd have to drain
    // ourselves — inotifywait's own "Setting up watches"/"Couldn't watch"
    // lines otherwise fill the pipe buffer and block the child from ever
    // delivering another event.
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['file', $logFile, 'a']];
    $proc = proc_open($cmd, $descriptors, $pipes);
    if ($proc === false) {
        dormouse_log($logFile, 'failed to start inotifywait');
        return null;
    }
    fclose($pipes[0]);
    stream_set_blocking($pipes[1], false);
    dormouse_log($logFile, sprintf('inotifywait started watching %d dirs', count($watchDirs)));
    return ['proc' => $proc, 'stdout' => $pipes[1], 'buffer' => ''];
}

function dormouse_stop_inotify_child(?array &$child, string $logFile): void
{
    if ($child === null) {
        return;
    }
    @fclose($child['stdout']);
    proc_terminate($child['proc']);
    proc_close($child['proc']);
    dormouse_log($logFile, 'inotifywait stopped');
    $child = null;
}

/**
 * Drains whatever is currently available on the child's stdout, non-blocking.
 * Returns null (instead of an empty array) if the child has exited — an EOF
 * on a live process, distinct from "nothing to read right now" — so the
 * caller can reap it and force an immediate watch-list rebuild + restart
 * rather than spinning on a dead pipe.
 */
function dormouse_drain_inotify(array &$child): ?array
{
    $lines = [];
    $chunk = fread($child['stdout'], 65536);
    if ($chunk === false || $chunk === '') {
        return feof($child['stdout']) ? null : $lines;
    }
    $child['buffer'] .= $chunk;
    while (($pos = strpos($child['buffer'], "\n")) !== false) {
        $lines[] = substr($child['buffer'], 0, $pos);
        $child['buffer'] = substr($child['buffer'], $pos + 1);
    }
    return $lines;
}

file_put_contents($pidFile, getmypid() . PHP_EOL);
dormouse_log($logFile, 'dormoused started (pid ' . getmypid() . ')');

$config = dormouse_load_config($cfgFile);
$db = dormouse_open_db($config['db_path']);

$running = true;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$running) {
    $running = false;
});

$watchDirs = dormouse_build_watch_dirs($config['pool_root'], $config['watched_shares'], $config['watch_depth']);
dormouse_log($logFile, sprintf('watch refresh: %d dirs found', count($watchDirs)));
dormouse_set_watch_stats($db, count($watchDirs));
$inotifyChild = dormouse_start_inotify_child($watchDirs, $runDir, $logFile);

$smbSeen = [];
$accessBuffer = []; // key => ['share','rel_path','first_ts','count']
$lastSmbPoll = 0;
$lastDiskPoll = 0;
$lastZfsPoll = 0;
$lastWatchRefresh = time();
$lastTrim = 0;
$accessWindowSeconds = 60;
$diskState = []; // name => ['spundown','numReads','numWrites','device']
$zfsState = []; // "dataset\0<name>"|"device\0<name>" => raw counters

while ($running) {
    if ($inotifyChild !== null) {
        $read = [$inotifyChild['stdout']];
        $write = null;
        $except = null;
        $result = @stream_select($read, $write, $except, 1);
        if ($result === false) {
            // interrupted by our own SIGTERM handler — loop will re-check $running
            continue;
        }
        $lines = dormouse_drain_inotify($inotifyChild);
        if ($lines === null) {
            dormouse_log($logFile, 'inotifywait child exited unexpectedly — forcing watch rebuild + restart');
            dormouse_stop_inotify_child($inotifyChild, $logFile);
            $lastWatchRefresh = 0;
            continue;
        }
        foreach ($lines as $line) {
            if (dormouse_inotify_line_is_overflow($line)) {
                dormouse_stat_incr($db, 'inotify_overflow_count');
                dormouse_log($logFile, 'IN_Q_OVERFLOW: ' . $line);
                continue;
            }
            $parsed = dormouse_parse_inotify_line($line);
            if ($parsed === null || in_array('ISDIR', $parsed['events'], true)) {
                continue;
            }
            $mapped = dormouse_inotify_dir_to_share($parsed['dir'], $config['pool_root'], $config['watched_shares']);
            if ($mapped === null) {
                continue;
            }
            [$share, $subPath] = $mapped;
            $relPath = $subPath === '' ? $parsed['file'] : $subPath . '/' . $parsed['file'];

            if (in_array('ACCESS', $parsed['events'], true)) {
                dormouse_accumulate_access($accessBuffer, $share, $relPath, time());
            }
            if (in_array('OPEN', $parsed['events'], true)) {
                dormouse_record_activity($db, time(), $relPath, $share, '', 'inotify', 'open');
            }
            if (in_array('CLOSE_NOWRITE', $parsed['events'], true)) {
                dormouse_record_activity($db, time(), $relPath, $share, '', 'inotify', 'close');
            }
            if (in_array('CLOSE_WRITE', $parsed['events'], true)) {
                // Uncoalesced, unlike ACCESS — a write is rare enough (and
                // significant enough) that one row per file is fine.
                dormouse_record_activity($db, time(), $relPath, $share, '', 'inotify', 'write');
            }
        }
    } else {
        sleep(1);
    }

    $now = time();

    dormouse_flush_expired_access($db, $accessBuffer, $now, $accessWindowSeconds);

    if ($now - $lastSmbPoll >= $config['smb_poll_seconds']) {
        $binary = trim((string) shell_exec('command -v smbstatus 2>/dev/null'));
        if ($binary !== '') {
            $json = shell_exec('smbstatus -j 2>/dev/null');
            $handles = dormouse_parse_smbstatus_json((string) $json, $config['watched_shares']);
            [$rows, $smbSeen] = dormouse_smb_diff($handles, $smbSeen);
            foreach ($rows as $row) {
                dormouse_record_activity($db, $now, $row['rel_path'], $row['share'], $row['client_ip'], 'smb', $row['event']);
            }
        }
        $lastSmbPoll = $now;
    }

    if ($now - $lastDiskPoll >= $config['smb_poll_seconds']) {
        // Reading disks.ini (tmpfs, emhttpd-maintained) never touches the
        // pool — the sanctioned way to know spin state (CLAUDE.md). Do NOT
        // stat() or otherwise poll /mnt/snowflake itself here.
        $raw = @file_get_contents($disksIniFile);
        if ($raw !== false) {
            $sections = dormouse_parse_disks_ini($raw);
            $poolDisks = dormouse_pool_disk_names($sections, $config['pool_disk_prefix']);
            [$diskRows, $diskState] = dormouse_disk_poll_tick($diskState, $sections, $poolDisks);
            foreach ($diskRows as $row) {
                dormouse_record_activity(
                    $db,
                    $now,
                    $row['rel_path'],
                    '',
                    '',
                    'disk',
                    $row['event'],
                    $row['reads_delta'] ?? 0,
                    $row['reads_delta'],
                    $row['writes_delta']
                );
                [$diskName, $device] = explode('/', $row['rel_path'], 2) + [1 => ''];
                dormouse_stat_set($db, "disk_state_$diskName", $sections[$diskName]['spundown'] === '1' ? 1 : 0);
                dormouse_stat_set($db, "disk_state_{$diskName}_since", $now);

                // Cross-check only on an actual transition, never as a regular
                // poll — smartctl -n standby does not wake the disk, but there
                // is no reason to shell out every tick either.
                if ($device !== '' && ($row['event'] === 'spinup' || $row['event'] === 'spindown')) {
                    $standby = dormouse_smartctl_standby($device);
                    if ($standby !== null) {
                        $iniSpundown = $sections[$diskName]['spundown'] === '1';
                        if (!dormouse_smartctl_agrees($iniSpundown, $standby)) {
                            dormouse_stat_incr($db, 'disk_state_disagreements');
                            dormouse_log($logFile, sprintf(
                                'smartctl disagrees with disks.ini for %s (%s): disks.ini spundown=%s, smartctl standby=%s',
                                $diskName,
                                $device,
                                $iniSpundown ? 'true' : 'false',
                                $standby ? 'true' : 'false'
                            ));
                        }
                    }
                }
            }
            dormouse_stat_set($db, 'disk_last_poll_ts', $now);
        }
        $lastDiskPoll = $now;
    }

    if ($now - $lastZfsPoll >= $config['smb_poll_seconds']) {
        // Source D — kstats only, never a pool-management CLI on a timer
        // (CLAUDE.md): reading /proc/spl/kstat/zfs/* and /proc/diskstats
        // never touches the pool.
        $datasets = [];
        foreach (dormouse_list_objset_files($config['zfs_kstat_dir'], $config['zfs_pool_name']) as $objsetFile) {
            $raw = @file_get_contents($objsetFile);
            if ($raw === false) {
                continue;
            }
            $parsed = dormouse_parse_objset_file($raw);
            if ($parsed !== null) {
                $datasets[$parsed['dataset_name']] = $parsed;
            }
        }

        $devices = [];
        $disksRaw = @file_get_contents($disksIniFile);
        $diskstatsRaw = @file_get_contents('/proc/diskstats');
        if ($disksRaw !== false && $diskstatsRaw !== false) {
            $sections = dormouse_parse_disks_ini($disksRaw);
            $poolDisks = dormouse_pool_disk_names($sections, $config['pool_disk_prefix']);
            $diskstats = dormouse_parse_diskstats($diskstatsRaw);
            $devices = dormouse_zfs_device_stats($sections, $poolDisks, $diskstats);
        }

        [$zfsRows, $zfsState] = dormouse_zfs_poll_tick($zfsState, $datasets, $devices);
        foreach ($zfsRows as $row) {
            dormouse_record_zfs_io($db, $now, $row['kind'], $row['name'], $row['reads'], $row['nread'], $row['writes'], $row['nwritten'], $row['unlinks']);
        }
        dormouse_stat_set($db, 'zfs_last_poll_ts', $now);
        $lastZfsPoll = $now;
    }

    // Checked again here, not just at the top of the loop: a SIGTERM that
    // lands mid-iteration must not walk the pool (possibly tens of seconds
    // on a cold start) before honouring shutdown — rc.dormouse only waits
    // 10s before declaring the daemon stopped and letting the install block
    // start a new one.
    if (!$running) {
        break;
    }

    if ($now - $lastWatchRefresh >= $config['watch_refresh_minutes'] * 60) {
        $start = microtime(true);
        $newWatchDirs = dormouse_build_watch_dirs($config['pool_root'], $config['watched_shares'], $config['watch_depth']);
        $duration = microtime(true) - $start;
        dormouse_log($logFile, sprintf('watch refresh: %d dirs found in %.2fs', count($newWatchDirs), $duration));
        dormouse_set_watch_stats($db, count($newWatchDirs));
        // ponytail: also restart whenever the child is dead (crash, or the
        // forced rebuild above), even if the dir list is unchanged — no
        // backoff on a persistently-failing child, just a log line per cycle.
        if ($inotifyChild === null || $newWatchDirs !== $watchDirs) {
            dormouse_stop_inotify_child($inotifyChild, $logFile);
            $watchDirs = $newWatchDirs;
            $inotifyChild = dormouse_start_inotify_child($watchDirs, $runDir, $logFile);
        }
        $lastWatchRefresh = $now;
    }

    if ($now - $lastTrim >= 3600) {
        dormouse_trim_activity($db, $config['activity_retain_days'], $now);
        dormouse_trim_zfs_io($db, $config['activity_retain_days'], $now);
        $lastTrim = $now;
    }
}

dormouse_flush_all_access($db, $accessBuffer, time());
dormouse_stop_inotify_child($inotifyChild, $logFile);
dormouse_log($logFile, 'dormoused stopping (pid ' . getmypid() . ')');
